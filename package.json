{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "data:check": "tsx --conditions=react-server scripts/data-check.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "record": "tsx --conditions=react-server scripts/record.ts",
    "predev": "tsx --conditions=react-server scripts/check-setup.ts",
    "supervision:snapshot": "tsx --conditions=react-server scripts/supervision-snapshot.ts"
  },
  "dependencies": {
    "next": "16.2.4",
    "openai": "^7.50.0",
    "papaparse": "^5.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
