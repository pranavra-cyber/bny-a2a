OPENAI_API_KEY=
# Defaults to gpt-6.1-terra when blank.
OPENAI_MODEL=
# replay = play a saved run (no API calls), live = call OpenAI, mock = scripted agents (no API calls; dev/tests).
DEMO_MODE=replay
# Hard cap of $0.20 of model usage per user request; prices must match OPENAI_MODEL.
COST_LIMIT_USD=0.20
MODEL_INPUT_USD_PER_1M=1.00
MODEL_OUTPUT_USD_PER_1M=5.00
MODEL_CACHED_INPUT_USD_PER_1M=0.05

# Optional. Reasoning effort for gpt-5+/o-series models (default low; "off" to omit the parameter).
# OPENAI_REASONING_EFFORT=
# Optional. Default max_output_tokens per call (default 2000 for reasoning models, else 600).
# MODEL_MAX_OUTPUT_TOKENS=
